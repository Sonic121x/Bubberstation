//code/game/objects/items/stacks/tiles/tile_reskinning.dm
/obj/item/stack/tile/click_alt(mob/user)
	var/list/radial_options = list()
	if(tile_reskin_types && tile_rotate_dirs)
		var/list/option_actions = list("更换外观" = "Reskin", "旋转" = "Rotate")
		radial_options["更换外观"] = image(icon = 'icons/hud/radial.dmi', icon_state = "radial_reskin")
		radial_options["旋转"] = image(icon = 'icons/hud/radial.dmi', icon_state = "radial_rotate")
		var/radial_result = show_radial_menu(user, src, radial_options, require_near = TRUE, tooltips = TRUE)
		switch(option_actions[radial_result])
			if("Reskin")
				return tile_reskin(user)
			if("Rotate")
				return tile_rotate(user)
		return
	if(tile_reskin_types)
		return tile_reskin(user)
	if(tile_rotate_dirs)
		return tile_rotate(user)
	return ..()
