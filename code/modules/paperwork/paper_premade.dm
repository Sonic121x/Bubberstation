/obj/item/paper/fluff/sop
	name = "纸张 - '标准操作程序'"
	default_raw_text = {"警报等级：
	<br>蓝色 - 紧急情况
	&emsp;1. 由火灾引发
	&emsp;2. 由手动操作引发
	<br>&emsp;操作：
	&emsp;&emsp;关闭所有防火门。这些门只有在重置警报后才能打开。
	<br>红色 - 弹射/自毁
	&emsp;1. 由模块操作计算机引发。
	<br>&emsp;操作：
	&emsp;&emsp;在指定时间之后，模块将完全弹射。
	<br>引擎维护指示：
	&emsp;关闭点火系统：
	&emsp;激活内部电源
	&emsp;激活轨道平衡矩阵
	&emsp;清除区域内的易挥发液体
	&emsp;穿戴防火服
	<br>&emsp;之后
	&emsp;&emsp;进行净化
	&emsp;&emsp;前往医疗检查官处
	<br>毒素实验室规程：
	&emsp;无论如何都要佩戴防毒面具
	&emsp;拿一个氧气罐
	&emsp;激活内部大气
	<br>&emsp;之后
	&emsp;&emsp;进行净化
	&emsp;&emsp;前往医疗检查官处
	<br>灾难规程：
	<br>&emsp;火灾：
	&emsp;&emsp;启动区域火警
	&emsp;&emsp;转移到安全区域
	&emsp;&emsp;拿一件防火服
	<br>&emsp;&emsp;之后：
	&emsp;&emsp;&emsp;评估损害
	&emsp;&emsp;&emsp;修复损害
	&emsp;&emsp;&emsp;如有必要，进行撤离
	<br>&emsp;流星雨：
	&emsp;&emsp;启动火警
	&emsp;&emsp;转移到船体后部
	<br>&emsp;&emsp;之后：
	&emsp;&emsp;&emsp;修复损害
	&emsp;&emsp;&emsp;如有必要，进行撤离
	<br>&emsp;意外再入大气层：
	&emsp;&emsp;启动船体前部的火警
	&emsp;&emsp;将易挥发物质转移到防火区域
	&emsp;&emsp;拿一件防火服
	&emsp;&emsp;保持安全，直到救援船抵达
	<br>&emsp;&emsp;如果救援船未到达——
	&emsp;&emsp;&emsp;撤离到附近的安全区域
	"}

