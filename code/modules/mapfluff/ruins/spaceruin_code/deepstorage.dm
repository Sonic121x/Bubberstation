/////////// deepstorage items

/obj/item/paper/fluff/ruins/deepstorage/water_concern
	name = "用水问题"
	default_raw_text = "致那些洗长热水澡停不下来的人：下一次采冰任务就派你去。如果你觉得非要在‘放松’时间里把该死的清水用个精光，那你就得为这些水干活，绝对跑不了！"

/obj/item/paper/fluff/ruins/deepstorage/hydro_notice
	name = "水培通知"
	default_raw_text = "水培是我们这里的命脉，它要是死了，我们也活不了。给我把那些该死的植物浇好水！"

/obj/item/paper/fluff/ruins/deepstorage/recycling_notice
	name = "回收通知"
	default_raw_text = "请务必将所有多余垃圾扔进后面的粉碎机！只要把别人眼里的‘垃圾’反复塞进巨型粉碎机，能从中弄出来的东西可真是惊人。"

