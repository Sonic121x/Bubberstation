//Whiteship (Abandoned Ship) Fluff


//Cere-class Salvage Cruiser
/obj/item/paper/fluff/ruins/whiteship/cere/cargo_vent
	name = "便条"
	default_raw_text = "在把货舱朝太空打开之前，记得先给它泄压。顺便说一句，操作时通知一下船员，免得把船员舱或酒吧也一起排空了。"

/obj/item/paper/fluff/ruins/whiteship/cere/comical_foreshadowing
	name = "日志条目"
	default_raw_text = "这些打捞作业迟早会把我们害死。我发誓。"

/obj/item/paper/crumpled/bloody/ruins/whiteship/cere/captain_suicide
	name = "遗书"
	default_raw_text = "那些……东西上船了。我的船员都死了，我把自己闩在了里面。我听到外面有滑行的声音，我快饿死了。再见了。"

/obj/item/paper/crumpled/bloody/ruins/whiteship/cere/told_you_so
	name = "字迹潦草的便条"
	default_raw_text = "你瞧瞧。我就说嘛，这破事迟早要反噬。"

/obj/item/paper/crumpled/bloody/ruins/whiteship/cere/firedoor_glitch
	name = "防火门电路故障"
	desc = "看来写这个的人被什么血腥的东西打断了。"
	default_raw_text = "由于防火门电路持续出问题，只有酒吧装了防火门，以防——"
