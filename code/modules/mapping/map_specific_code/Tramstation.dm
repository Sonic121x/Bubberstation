/obj/modular_map_root/tramstation
	config_file = "strings/modular_maps/Tramstation.toml"

/obj/item/paper/fluff/genpop_instructions
	name = "监狱公共区——囚犯处理与你"
	desc = "一张折得整整齐齐的纸，讲解如何使用监狱公共区储物柜和收监系统。"
	default_raw_text = @{"

<center><b>新囚犯处理操作指南</center>
</b> <br>

<br> 如需通过本监狱公共区系统处理囚犯，请参阅下列清单以了解正确的处理流程：
<br> 1. 在监狱公共区储物柜上刷入新囚犯的 ID，将其与储物柜关联。把囚犯的装备存放在这个储物柜里。
<br> 2. 在囚犯的 ID 上刷你的 ID，并为其设定刑期时长。把 ID 挂到囚犯身上。
<br> 3. 让囚犯通过标有标记的安保闸门，无论其自愿还是被迫。这会启动其卡片上的计时器并开始服刑。
<br> 4. 刑期结束后，他们的 ID 会再次允许他们通过闸门，他们便能自由取回自己的物品。
<br> 5. 押送刚出狱的前囚犯从监狱前门离开，回到站内。
	"}
