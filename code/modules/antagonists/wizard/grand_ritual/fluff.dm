/**
 * Fluff book to hint at the cheesy grand ritual.
 */
/obj/item/book/manual/ancient_parchment
	name = "古老羊皮纸"
	icon = 'icons/obj/scrolls.dmi'
	icon_state = "scroll-ancient"
	unique = TRUE
	w_class = WEIGHT_CLASS_SMALL
	starting_author = "疯狂者佩拉吉乌斯"
	starting_title = "对神圣疯狂的崇拜与敬仰"
	starting_content = {"<html>
		<head>
		<meta http-equiv='Content-Type' content='text/html; charset=UTF-8'>
		</head>
		<body>
		<i>卷轴的大部分内容已无法辨认，上面长满霉斑、沾着奶渍，还散发着一股变质山羊奶酪的浓烈臭味，<br>
		你几乎忍不住扭头干呕。残存的文字含糊而抽象，仿佛作者<br>
		是在匆忙之中仓促记录下自己的发现。<br><br>
		然而，他们设法刻在羊皮纸上的符文却奇异地未被时间侵蚀，依然清晰可辨。<br>
		你还发现了一张更常见的宏大仪式符文图样，只是上面点缀着黄色圆圈，而这些圆圈里又<br>
		填满了黑色圆点。这些该不会是……<b>奶酪轮吧？……</b><br><br>
		当你浏览完这份残破不堪的卷轴时，你听见心灵视界之外的某处传来一阵微弱的窃笑……</i><br>
		</body>
		</html>"}
