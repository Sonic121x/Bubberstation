/datum/map_template/shuttle/whiteship
	port_id = "whiteship"
	prefix = "_maps/shuttles/whiteship/"

/datum/map_template/shuttle/whiteship/box
	suffix = "box"
	name = "Hospital Ship"
	description = "载有医疗物资的白船。僵尸目前不会生成尸体，也没有传染性。"

/datum/map_template/shuttle/whiteship/meta
	suffix = "meta"
	name = "Salvage Ship"
	description = "以可供玩家建造的大型货舱为主的白船。生成时带有极具攻击性、死后不留下尸体的辛迪加单位。"

/datum/map_template/shuttle/whiteship/pubby
	suffix = "pubby"
	name = "NT Science Vessel"
	description = "一艘仅使用单一区域、满是愤怒蚂蚁的小型科研船。"

/datum/map_template/shuttle/whiteship/cere
	suffix = "cere"
	name = "NT Heavy Salvage Vessel"
	description = "一艘坚固、功能齐全的打捞船，带有两具尸体（矿工和工程师）及一顶舰长帽。配有太阳帆和 PACMAN 发电机。"

/datum/map_template/shuttle/whiteship/birdshot
	suffix = "birdshot"
	name = "NT Patrol Bee"
	description = "一艘用中央走廊连接所有房间的小型巡逻舰。配有两个小货舱和一个禁闭室。生成时带有一只凶猛致命的胶质方块怪。"

/datum/map_template/shuttle/whiteship/kilo
	suffix = "kilo"
	name = "NT Mining Shuttle"
	description = "一艘形状古怪的采矿船，初始带有几只愤怒的冥界生物。"

/datum/map_template/shuttle/whiteship/donut
	suffix = "donut"
	name = "NT Long-Distance Bluespace Jumper"
	description = "一艘因引擎爆炸而变成失压空壳的船。供电无限，不过很容易诱使人们破坏这一特点。也是所有白船中最开阔的一艘，初始有 25% 概率带有雷普利机甲。"

/datum/map_template/shuttle/whiteship/tram
	suffix = "tram"
	name = "NT Long-Distance Bluespace Freighter"
	description = "一艘细长的穿梭机，初始带有纳米传讯私人安保人员的尸体。无法停入基地船坞！但能停入深空站的船坞。"

/datum/map_template/shuttle/whiteship/delta
	suffix = "delta"
	name = "NT Frigate"
	description = "一艘载有巨型蜘蛛的标准白船。PACMAN 发电机未接线，放在主电网电缆旁，需要稍作处理。"

/datum/map_template/shuttle/whiteship/personalshuttle
	suffix = "personalshuttle"
	name = "Personal Travel Shuttle"
	description = "一艘载有几只僵尸和一具可搜刮的工程师尸体的小船。"

/datum/map_template/shuttle/whiteship/obelisk
	suffix = "obelisk"
	name = "Obelisk"
	description = "一艘受纳尔西血教影响的大型科研船。PACMAN 发电机未接线，放在主电网电缆旁，需要稍作处理。"
	admin_notes = "其实不是方尖碑，带有无自主意识的血教构装体。"
