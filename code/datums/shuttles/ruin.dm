/datum/map_template/shuttle/ruin
	port_id = "ruin"
	prefix = "_maps/shuttles/ruin/"
	who_can_purchase = null

/datum/map_template/shuttle/ruin/cyborg_mothership
	suffix = "cyborg_mothership"
	name = "Cyborg Mothership"
	description = "一艘为硅基生命操作而设计的高度工业化船舰，被蜂群机器人和太空藤蔓侵占。"

/datum/map_template/shuttle/ruin/caravan_victim
	suffix = "caravan_victim"
	name = "Small Freighter"
	description = "小型货船，初始几乎完全断电，载有三名辛迪加突击队员和一名辛迪加风暴兵，船体还有一个大破口。"

/datum/map_template/shuttle/ruin/pirate_cutter
	suffix = "pirate_cutter"
	name = "Pirate Cutter"
	description = "配有实弹炮塔的小型海盗船。生成时有三名海盗，其中一名掉落能量弯刀。"

/datum/map_template/shuttle/ruin/syndicate_dropship
	suffix = "syndicate_dropship"
	name = "Syndicate Dropship"
	description = "配有激光炮塔的轻型辛迪加船舰。生成时舰桥内有一名辛迪加单位。"

/datum/map_template/shuttle/ruin/syndicate_fighter_shiv
	suffix = "syndicate_fighter_shiv"
	name = "Syndicate Fighter"
	description = "一艘小型辛迪加船舰，只有一格可用内部空间，配有四座激光炮塔。初始驾驶座上有一名辛迪加单位，内部极其拥挤。"
