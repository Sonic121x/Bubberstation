/* ----------------- Fluff/Paper ----------------- */

/obj/item/paper/fluff/ruins/tarkon
	name = "纸张——《工程报告》"
	default_raw_text = "<B>让虚空诅咒上一批船员吧</B><BR><BR>一切都乱得他妈一塌糊涂——通往科研区的走廊竟然有个该死的<b>大洞</b>！<br><br><b>幸好</b>，新设计的快速建造装置派上了用场……我发誓，他们拿走了那件遗物，却给了我一个可能更差的东西……不过科研部保证，弄坏了还能换……他们还给了我那块藏着的电路板，我把它和蓝图一起放进太阳能超导磁储能装置旁的保险柜了……感觉那地方不错。"

/obj/item/paper/fluff/ruins/tarkon/goals
	name = "纸张——《塔肯工业》"
	default_raw_text = "<h1>塔肯工业介绍指南</h1><br><br><b>塔肯工业</b>希望为普通拓居者规划长远的未来，为普通太空居民建立安居之所，为商人创造未来的投资机会，乃至让人们在小行星带中建立大型社区。<br><br><b>我们最优秀的工程师</b>日夜工作，致力于打造稳定而结构可靠的系统，将空间站、生活区和港口植入小行星及小型星体——这些天体太小，无法像宜居带行星那样维持生命。<br><br><b>我们为自己的传承深感自豪</b>，凭借勤劳协作的传统为同胞创造未来，激励后代取得更大成就、开展更深入研究、建设更宏伟项目。<br><br><b>想来帮忙？</b>欢迎前往塔肯工业总部，当前坐标信号可在猎户座腰带附近探测到。我们正积极招募聪明的人才和优秀的工人加入。<br><br><br>塔肯工业：一枚钉子、一颗小行星，逐步建造未来。2456—2500年版权所有。"

/obj/item/paper/fluff/ruins/tarkon/vaulter
	name = "纸张——《塔肯跃进者》"
	default_raw_text = "<h1>塔肯工业设计：</h1><br><h2>塔肯跃进者原型</h2><br><br><b>跃进者大量借鉴了开拓者的设计</b>，理念相近，但规模大得多。它面向更大的小型星体，甚至月球及类似行星卫星，是塔肯迈向太空拓居的又一步。不过，两者的差别在于建造系统。跃进者更注重垂直施工，通常先在着陆点下方开挖洞穴、建造主室，然后部署电梯。<br><br><b>开拓者</b>需要在早期建设额外电力系统，而跃进者计划配备更多放射性同位素热电发生器，为初始基地建设供电。代价是体积更大，也需要更多材料储备，才能在首次航程中建成规模足够的作业区。开拓者目前处于早期测试阶段，我们希望先完善其设计，再将精力转向跃进者，并期望后者在二十六世纪初进入测试。"

/obj/item/paper/fluff/ruins/tarkon/driverpitch
	name = "纸张——《塔肯开拓者》"
	default_raw_text = "<h1>塔肯工业设计：</h1><br><h2>塔肯开拓者原型</h2><br><br><b>见证了太空采矿的成功后</b>，塔肯工业希望将钻机的理念拓展到更宏大的目标。开拓者装有钻头和多个固定用凸轮机构，能够从侧面嵌入大型小行星或小型星体。钻出空间后，钻头可以展开并逐步回收，用以开始建造作业基地。<br><br><b>挖好第一个区域后</b>，首要任务是增建发电区，或部署便携发电机，为后续开采供能，逐步掏空星体并建造墙壁、地板和天花板。开拓者通过凸轮机构稳固就位后，后半段可以脱离，作为运送材料、人员和工具的摆渡飞船。<br><br><b>首台塔肯开拓者将于2479年准备测试</b>。我们已找到一颗合适的小行星，希望在2480年初完成对接。"

/obj/item/paper/fluff/ruins/tarkon/detain
	name = "纸张——《塔肯拘留记录》"
	default_raw_text = "<h1>塔肯工业拘留记录：</h1><br><br><b>被拘留者：</b>阿库斯·维尔科夫<br><b>职级／职业：</b>初级科学家<br><b>原因：</b>企图破坏运行中的发电机。<br><br><b>被拘留者：</b>蒂尔伯·辛斯<br><b>职级／职业：</b>见习矿工<br><b>原因：</b>在墙边引爆不稳定岩簇，导致三小时的重建工作。<br><br><b>被拘留者：</b>杰拉尔特·安东诺夫<br><b>职级／职业：</b>工程专家<br><b>原因：</b>公共场所醉酒。<br><br><b>被拘留者：</b>明克·阿恩茨<br><b>职级／职业：</b>实地研究员<br><b>原因：</b>拆解一把M6，以研究太空尘埃对实弹枪械的影响。<br><br><b>被拘留者：</b>雷南塔·麦克罗里<br><b>职级／职业：</b>外科医生<br><b>原因：</b>医疗事故，将患者的拇指与大脚趾互换。已逐出场站。"

/obj/item/paper/fluff/ruins/tarkon/scisafe
	name = "纸张——《科研保险柜通知》"
	default_raw_text = "<b>在另行通知之前</b>，我们不会发放保险柜密码。<br><br>谁拿走了研究物品，就等着被踢进下一支清剿队吧。<br><br>没错，它还在手术室。<br>没错，密码已经重置。"

/obj/item/paper/fluff/ruins/tarkon/cargosafe
	name = "纸张——《货运保险柜便条》"
	default_raw_text = "嘿……主管查看资金时撞到了桌子，很不高兴，所以我们把它搬进了仓库。<br>去空气警报器旁的壁龛看看，完事后记得给地砖补漆。<br>附言：能把密码写下来就给你50信用点。"

/obj/item/paper/fluff/ruins/tarkon/sop
	name = "纸张——《塔肯安保标准作业程序》"
	default_raw_text = "你好，执法者。你大概知道，我们没有完备的长期关押设施……至少没法在不惹恼某些政府的情况下这么干。所以，办法如下。<br><br>如果有人擅闯，先问清来历。附近似乎有座空间站，所以……他们多半来自那里。只要不必开枪，就仅扣留问话。<br><br>如果是自己人，嗯……你就正式兼任典狱长，还得喂他们吃饭。真倒霉。你也可以问他们，愿不愿意带着分配给他们的东西被丢进虚空。不过提醒一下，出了大事你要负责。<br><br>最后，不要扣留不愿留在港口的人。放走后，你可以采取任何措施确保他们不再回来，包括把他们扔进太空，或送到最近的空间站。"

/obj/item/paper/fluff/ruins/tarkon/arcs
	name = "纸张——《塔肯工业先进共振控制系统》"
	default_raw_text = "<h1>塔肯工业设计：</h1><br><h2>先进共振控制系统</h2><br><br><b>在使用标准“共振器”并发现其缺陷后</b>，塔肯工业重新审视了它和当今常见的采矿装备。接触到所谓的“原型动能加速器”后，工程师们开始拆解、重组和改造，最终打造出令我们引以为傲的系统。<br><br><b>它可在自动激活和双周期激活之间切换</b>。该系统将太空中的硅酸盐尘埃压缩成薄晶片，通过“压电共振”传递大量能量，让晶体以短暂稳定的振幅振动，并能在自行撕裂的频率与需要二次触发、更具破坏性的频率之间切换。<br><br><b>安全提醒：</b>矿工进入站内时必须打开保险，因为短暂稳定的晶片能够把共振能量传递给有机生物。"

/obj/item/paper/fluff/ruins/tarkon/trcd
	name = "纸张——《塔肯工业工程改良快速建造装置》"
	default_raw_text = "<h1>塔肯工业设计：</h1><br><h2>先进快速建造装置设计升级</h2><br><br><b>作为从事建筑工程、空间站建设和港口维护的企业</b>，塔肯工业审视了所提供的工具，发现它们并不尽如人意。标准快速建造装置功能有限。虽然我们还没能扩展设计，造出更坚固的墙壁（暂时没有，我们仍在努力），但近期发现的“蓝空间量子纠缠”带来了突破。<br><br><b>借助蓝空间，对快速建造装置的建造机构进行量子纠缠</b>，我们设计出一种工具，让工程师可以在手臂够不到的距离扩建港口、修补破口，甚至建造气闸。<br><br><b>虽然我们仍无法重现所获“遗物”的效率与材料容量<b>，但已将其送回允许我们研究它的港口货舱，同时附上升级后的快速建造装置，让他们可以展示那件遗物，而非继续使用。"

/obj/item/paper/fluff/ruins/tarkon/comsafe
	name = "纸张——《指挥保险柜便条》"
	default_raw_text = "呵……那些老文件我实在舍不得扔，它们总让我想起自己当初为什么接下这份工作。那些“未来安全”的宣传词……如今呢？随便哪个傻瓜都能买一盒自己的小型建造机……没想到我们也弄来了一台，里面有些设计还挺实用……<br><br>好吧，先不说这个，我们确实收到了升级过的新电路板。按行业标准，科研建造设备电路板给了两套作为冗余，所以备用那套放进了通讯室的特殊保险柜。"

/obj/item/blueprints/tarkon
	desc = "塔肯地表破岩钻机及多种基地方案的蓝图，背面盖着红色的“机密”印章。"
	name = "塔肯设计蓝图"
