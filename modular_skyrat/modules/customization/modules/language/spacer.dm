/datum/language/spacer
	name = "Spacer"
	desc = "如果说通用语是商业的语言，那么太空人语就是它阴暗的表亲，常用于以更正规的语言建立对话的尝试失败、 \
		又没有自动翻译器可用的时候。	它高度依赖语调、肢体语言、手势，以及大量克里奥尔语借词。尽管多年来其使用率已大幅下降， \
		但在通用语知识并无保障、且注重隐私的边区地带，它依然有人使用。"
	key = "j"
	flags = LANGUAGE_TONGUELESS_SPEECH
	syllables = list(
		"ada", "zir", "bian", "ach", "usk", "ado", "ich", "cuan", "iga", "qing", "le", "que", "ki", "qaf", "dei", "eta"
	)
	icon_state = "spacer"
	icon = 'modular_skyrat/master_files/icons/misc/language.dmi'
	default_priority = 50
