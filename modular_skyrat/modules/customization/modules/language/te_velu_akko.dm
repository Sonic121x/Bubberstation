/datum/language/akulan
	name = "Te Velu Akko"
	desc = "阿库拉人流畅而富有韵律的语言，由他们远古时代最早的一批首领之一所创造。 \
		古老的形式更加流畅、更有韵律，而如今流行的形式则更急促、更粗硬，因此仅凭口音就能轻易辨认出大多数旧贵族与强硬派。 \
		人们可以把阿科语的发音与地球的毛利语相比。"
	key = "Z"
	flags = LANGUAGE_TONGUELESS_SPEECH
	space_chance = 70
