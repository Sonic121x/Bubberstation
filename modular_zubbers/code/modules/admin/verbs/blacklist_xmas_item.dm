ADMIN_VERB(blacklist_xmas_item, R_ADMIN, "将圣诞礼物列入黑名单", "拿走礼物，你这个坏蛋。", ADMIN_CATEGORY_GAME)
	var/item_to_ban = tgui_input_text(user, "要从圣诞树礼物中禁用哪个类型路径？", "偷走圣诞节……", max_length = 128)
	var/pathed_item = text2path(item_to_ban)
	if(ispath(pathed_item))
		LAZYADD(GLOB.xmas_gift_blacklist, item_to_ban)
		log_admin("[key_name(user)]将[item_to_ban]加入了圣诞礼物黑名单。")
		message_admins("[key_name(user)]将[item_to_ban]加入了圣诞礼物黑名单！")
	BLACKBOX_LOG_ADMIN_VERB("Blacklist Xmas Gift Item")
