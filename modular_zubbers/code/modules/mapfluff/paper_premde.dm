// Slap some pre-made written notes or papers around the map to add some flavor and worldbuilding.
// Maybe even some hints for players who are new to the map or the game in general.

/obj/item/paper/fluff/angryce
	name = "愤怒写下的便条"
	desc = "这张便条上到处是咖啡渍。看来有人把它当杯垫用了。"
	color = "#97745d"
	default_raw_text = {"来自你们总工程师的友好提醒，致本班次所有在休息室里一脸茫然的懒鬼安全帽；<br>
	<br> 你们真他妈需要那么大的沙发吗？！？！我是说，我懂，房间确实大，但拜托。
	<br> 我已经把那张沙发换成了小一点的。（说实话还是他妈太大了。）还铺了些电路机器。
	<br>
	<br> 要是你们打算一整天都瘫在沙发上，那不如顺手按几下按钮，多少干点正经事。
	"}
