/obj/item/organ/cyberimp/arm/toolkit/seclite
	name = "安保手电筒植入体"
	desc = "一款植入掌心内的安保手电筒型号。"
	items_to_create = list(/obj/item/flashlight/seclite/implant)

/obj/item/organ/cyberimp/arm/toolkit/penfour
	name = "四色笔植入体"
	desc = "一种内含四色笔的义体指尖替代物。"
