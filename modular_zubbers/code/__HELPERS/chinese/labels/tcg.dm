// BUBBER ADDITION: Card keywords keep their original lookup keys.
/proc/chinese_tcg_keyword_display(value)
	var/static/list/labels = list(
		"Asimov" = "阿西莫夫", "Blocker" = "阻挡者", "Changeling" = "变形怪", "Clockwork" = "发条",
		"Deadeye" = "神射手", "Faction" = "派系", "First Strike" = "先攻", "Fury" = "狂怒",
		"Graytide" = "灰潮", "Hivemind" = "蜂巢意识", "Holy" = "神圣", "Immunity" = "免疫",
		"On Equip" = "装备时", "On Summon" = "召唤时", "Squad Tactics" = "小队战术", "Taunt" = "嘲讽",
	)
	return labels[value] || value

// The source tags remain usable for card logic and searches.
/proc/chinese_tcg_type_display(value)
	var/static/list/labels = list("Science" = "科研", "Creature" = "生物", "Silicon" = "硅基", "Xeno" = "异星", "Wizardry" = "巫术", "Syndicate" = "辛迪加", "Abomination" = "畸变体", "Service" = "服务", "Maintenance" = "维修", "Engineering" = "工程", "Atmospherics" = "大气", "Bar" = "酒吧", "Plant" = "植物", "Plants" = "植物", "Command" = "指挥", "Equipment" = "装备", "Cargo" = "货运", "Medical" = "医疗", "Engineer" = "工程师", "Cybersun" = "赛博太阳", "Security" = "安保", "Animal" = "动物", "Clown" = "小丑", "Armour" = "护甲", "ERT" = "紧急响应小队", "Atmosian" = "大气信徒", "Human" = "人类", "Officer" = "警官", "Xenomorph" = "异形", "Event" = "事件", "Instant" = "瞬间", "Battlefield" = "战场", "Scientist" = "科学家", "Soldier" = "士兵")
	var/list/parts = splittext(value, " ")
	for(var/i in 1 to length(parts))
		parts[i] = labels[parts[i]] || parts[i]
	return jointext(parts, " ")

