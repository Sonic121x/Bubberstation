// Form codes and source HTML remain unchanged; only visible text is localized.
/proc/chinese_paper_blank_display(list/blank)
	var/list/display = blank.Copy()
	display["name"] = chinese_paper_blank_text(blank["name"])
	display["category"] = chinese_paper_blank_text(blank["category"])
	var/list/info = blank["info"]
	var/list/display_info = list()
	for(var/line in info)
		display_info += chinese_paper_blank_text(line)
	display["info"] = display_info
	return display

