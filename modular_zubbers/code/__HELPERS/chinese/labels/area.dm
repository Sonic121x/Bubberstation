/proc/chinese_teleporter_choice(mob/user, message, title, list/targets)
	var/list/display_choices = list()
	for(var/value in sort_list(targets))
		var/atom/target = targets[value]
		var/area/target_area = get_area(target)
		var/area_name = target_area ? format_text(target_area.name) : ""
		var/display_value = length(area_name) ? replacetext(value, area_name, chinese_area_display(area_name)) : value
		display_choices["[display_value] ([value])"] = value
	var/selection = tgui_input_list(user, message, title, display_choices)
	return isnull(selection) ? null : display_choices[selection]
